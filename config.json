{
  "categories": {
    "Audio": {
      "rename": true,
      "extensions": [".mp3", ".wav", ".flac", ".aac", ".m4a", ".ogg", ".wma"],
      "mime_types": ["audio/*"]
    },
    "Image": {
      "rename": true,
      "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".tiff", ".svg"],
      "mime_types": ["image/*"]
    },
    "Video": {
      "rename": true,
      "extensions": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".webm", ".m4v"],
      "mime_types": ["video/*"]
    },
    "PDF": {
      "rename": true,
      "extensions": [".pdf"],
      "mime_types": ["application/pdf"]
    },
    "Document": {
      "rename": true,
      "extensions": [".doc", ".docx", ".txt", ".rtf", ".odt", ".xls", ".xlsx", ".csv", ".ppt", ".pptx"],
      "mime_types": ["text/*", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.openxmlformats-officedocument.presentationml.presentation"]
    },
    "Archive": {
      "rename": true,
      "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2"],
      "mime_types": ["application/zip", "application/x-tar", "application/gzip", "application/x-7z-compressed", "application/x-rar-compressed"]
    },
    "Applications": {
      "rename": false,
      "extensions": [".exe", ".msi", ".apk", ".dmg", ".deb", ".rpm"],
      "mime_types": []
    },
    "Program": {
      "rename": false,
      "extensions": [".py",
    ".pyw",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".java",
    ".c",
    ".h",
    ".cpp",
    ".hpp",
    ".cc",
    ".cs",
    ".go",
    ".rs",
    ".php",
    ".rb",
    ".swift",
    ".kt",
    ".kts",
    ".dart",
    ".lua",
    ".r",
    ".sql",
    ".sh",
    ".bash",
    ".bat",
    ".cmd",
    ".ps1",
    ".psm1",
    ".html",
    ".htm",
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".json",
    ".xml",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg",
    ".conf",
    ".env",
    ".dll",
    ".sys",
    ".ocx",
    ".scr",
    ".com"],
      "mime_types": []
    }
  }
}
